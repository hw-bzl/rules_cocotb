load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "stubgen",
    srcs = glob(["src/**/*.rs"]),
    data = ["//tools/stubgen/private:verible_syntax"],
    edition = "2021",
    rustc_env = {
        "VERIBLE_SYNTAX_RLOCATIONPATH": "$(rlocationpath //tools/stubgen/private:verible_syntax)",
    },
    visibility = ["//visibility:public"],
    deps = [
        "@cocotb_stubgen_crates//:clap",
        "@cocotb_stubgen_crates//:serde_json",
        "@cocotb_stubgen_crates//:vhdl_lang",
        "@rules_rust//tools/runfiles",
    ],
)

rust_test(
    name = "stubgen_test",
    crate = ":stubgen",
    edition = "2021",
)

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])
